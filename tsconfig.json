{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@swissmouse/sdk": ["packages/sdk/index.ts"] },
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["packages", "src", "server.ts", "tools/audio-engine.ts", "scripts/*.ts"]
}
